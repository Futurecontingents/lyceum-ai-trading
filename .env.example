# Alpaca PAPER credentials only. OAuth-based CLI/MCP use does not need these.
ALPACA_API_KEY=your_paper_api_key
ALPACA_SECRET_KEY=your_paper_secret_key
ALPACA_PAPER=true
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex
LYCEUM_ALPACA_PROFILE=paper
# Set true only while validating a brand-new judging account before its first trade.
LYCEUM_EXPECT_FRESH_ACCOUNT=false

# READ_ONLY | SIMULATED | PAPER_AUTONOMOUS (there is deliberately no LIVE mode)
LYCEUM_EXECUTION_MODE=READ_ONLY
# Required in addition to PAPER_AUTONOMOUS. Leave false until explicitly enabling paper orders.
LYCEUM_ENABLE_PAPER_ORDERS=false
LYCEUM_DATABASE_PATH=data/lyceum.db
LYCEUM_HALT_FILE=HALT
LYCEUM_SCAN_INTERVAL_SECONDS=900

# DETERMINISTIC | HYBRID. HYBRID degrades safely if provider configuration is absent or fails.
LYCEUM_COUNCIL_MODE=DETERMINISTIC
LYCEUM_MODEL_PROVIDER=deterministic
LYCEUM_MODEL_BASE_URL=
LYCEUM_MODEL_NAME=
LYCEUM_MODEL_API_KEY=
LYCEUM_MODEL_TIMEOUT_SECONDS=12
LYCEUM_MODEL_RETRIES=1

# Featherless example (choose a current model ID from https://featherless.ai/models):
# LYCEUM_COUNCIL_MODE=HYBRID
# LYCEUM_MODEL_PROVIDER=openai_compatible
# LYCEUM_MODEL_BASE_URL=https://api.featherless.ai/v1
# LYCEUM_MODEL_NAME=
# LYCEUM_MODEL_API_KEY=
