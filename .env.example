# Alpaca PAPER credentials only. OAuth-based CLI/MCP use does not need these.
ALPACA_API_KEY=your_paper_api_key
ALPACA_SECRET_KEY=your_paper_secret_key
ALPACA_PAPER=true
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex

# READ_ONLY | SIMULATED | PAPER_AUTONOMOUS (there is deliberately no LIVE mode)
LYCEUM_EXECUTION_MODE=READ_ONLY
# Required in addition to PAPER_AUTONOMOUS. Leave false until explicitly enabling paper orders.
LYCEUM_ENABLE_PAPER_ORDERS=false
LYCEUM_DATABASE_PATH=data/lyceum.db
LYCEUM_HALT_FILE=HALT
LYCEUM_SCAN_INTERVAL_SECONDS=900

